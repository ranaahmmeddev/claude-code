/*
 * Gift card product template (Local theme 4.2.1).
 * Same as the default product template, but with the theme's Product information
 * section visible and "Show recipient information form for gift card products" on.
 * Assign it to the gift card product: Products > [gift card] > Theme template: gift-card
 */
{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "vendor": {
          "type": "vendor",
          "settings": {
            "text_size": "text-size--regular"
          }
        },
        "title": {
          "type": "title",
          "settings": {}
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "variants_style": "radio",
            "metaobject_swatch_metafields": "",
            "show_quantities": "no",
            "inventory_color_low": "rgba(0,0,0,0)",
            "inventory_color_enough": "rgba(0,0,0,0)",
            "inventory_color_out": "rgba(0,0,0,0)"
          }
        },
        "empty_space_1": {
          "type": "space",
          "settings": {}
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_price": true,
            "show_quantity_selector": true,
            "show_preorder": true,
            "show_dynamic_checkout": true,
            "show_gift_card_recipient": true,
            "color_text_buttons": "rgba(0,0,0,0)",
            "color_accent_buttons": "rgba(0,0,0,0)",
            "style_buttons": "solid"
          }
        },
        "empty_space_2": {
          "type": "space",
          "settings": {}
        },
        "description": {
          "type": "description",
          "settings": {
            "heading": "",
            "subtitle": "",
            "tooltip_info": "",
            "collapsible": false,
            "opened_by_default": false,
            "layout": "compact",
            "text_color": "rgba(0,0,0,0)",
            "bg_color": "rgba(0,0,0,0)",
            "darken_header": false
          }
        },
        "empty_space_3": {
          "type": "space",
          "settings": {}
        },
        "share": {
          "type": "share",
          "settings": {
            "title": "Share",
            "subtitle": "",
            "tooltip_info": "",
            "share_on_facebook": true,
            "share_on_x": true,
            "share_on_pinterest": true,
            "custom_share_link": false,
            "collapsible": false,
            "opened_by_default": false,
            "layout": "compact",
            "text_color": "rgba(0,0,0,0)",
            "bg_color": "rgba(0,0,0,0)",
            "darken_header": true
          }
        }
      },
      "block_order": [
        "vendor",
        "title",
        "variant_picker",
        "empty_space_1",
        "buy_buttons",
        "empty_space_2",
        "description",
        "empty_space_3",
        "share"
      ],
      "settings": {
        "gallery_style": "slider",
        "enhance_first_image": false,
        "gallery_ratio": "0.666667",
        "other_media_ratio": "fit",
        "video_fit": true,
        "gallery_fit": false,
        "show_border": false,
        "gallery_card_design": false,
        "gallery_padding": 4,
        "gallery_pagination": "dots",
        "enable_zoom": true,
        "enable_video_looping": false,
        "enable_video_autoplay": false,
        "disable_parallax": false,
        "default_to_first_variant": true,
        "sticky_add_to_cart": false,
        "sticky_atc_variants": false,
        "sticky_atc_style": "wide",
        "sticky_bar_bgcolor": "#ffffff",
        "sticky_bar_txtcolor": "#111111",
        "sticky_bar_blur": true
      }
    }
  },
  "order": [
    "main"
  ]
}
