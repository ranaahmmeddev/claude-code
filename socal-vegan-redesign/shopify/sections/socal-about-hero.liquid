{%- comment -%}
  SoCal About hero — SoCal section for the Local theme (v4.2.1).
  Built on the theme's typography, color, border and spacing variables with one accent.
{%- endcomment -%}

{{ 'socal-sections.css' | asset_url | stylesheet_tag }}

<div class="{% render 'socal-section-wrapper', section: section %}">
  <div class="socal-section socal-about-hero socal-about-hero--image-{{ section.settings.image_position }}" style="{% render 'socal-section-style', section: section %}">

    <div class="socal-about-hero__text">
      {%- if section.settings.eyebrow != blank -%}
  <p class="socal-eyebrow text-size--small text-weight--bold">{{ section.settings.eyebrow | escape }}</p>
{%- endif -%}
      <{{ section.settings.heading_tag }} class="{{ section.settings.heading_size }} socal-about-hero__title">
        {{- section.settings.heading | escape -}}
        {%- if section.settings.heading_highlight != blank %} <span class="socal-accent-text">{{ section.settings.heading_highlight | escape }}</span>{% endif -%}
        {%- if section.settings.heading_end != blank %} {{ section.settings.heading_end | escape }}{% endif -%}
      </{{ section.settings.heading_tag }}>
      {%- if section.settings.text != blank -%}
        <div class="socal-copy rte text-size--large text-color--secondary">{{ section.settings.text }}</div>
      {%- endif -%}
      {%- if section.settings.button_label != blank or section.settings.button_2_label != blank -%}
  <div class="socal-buttons">
    {%- if section.settings.button_label != blank -%}
      <a class="button button--solid button--regular" href="{{ section.settings.button_link | default: '#' }}">{{ section.settings.button_label | escape }}</a>
    {%- endif -%}
    {%- if section.settings.button_2_label != blank -%}
      <a class="button button--outline button--regular" href="{{ section.settings.button_2_link | default: '#' }}">{{ section.settings.button_2_label | escape }}</a>
    {%- endif -%}
  </div>
{%- endif -%}
    </div>
    <div class="socal-about-hero__media socal-media">
      {%- if section.settings.image != blank -%}
        {%- render 'lazy-image',
          image: section.settings.image,
          alt: section.settings.heading,
          ratio: '0.8',
          sizes: '(max-width: 1023px) calc(100vw - 40px), 40vw',
          preload: true
        -%}
      {%- else -%}
        <span class="socal-placeholder">{{ 'image' | placeholder_svg_tag }}</span>
      {%- endif -%}
    </div>
  </div>
</div>

{%- render 'socal-section-background', section: section -%}

{% schema %}
{
  "name": "SoCal About hero",
  "class": "socal-about-hero-section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "About The SoCal Vegan"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Real food."
    },
    {
      "type": "text",
      "id": "heading_highlight",
      "label": "Heading highlight",
      "info": "Shown in the accent color.",
      "default": "Plant-powered."
    },
    {
      "type": "text",
      "id": "heading_end",
      "label": "Heading end",
      "default": "Made for your week."
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag (SEO)",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        }
      ],
      "default": "h1"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        {
          "value": "h1",
          "label": "Extra large"
        },
        {
          "value": "h2",
          "label": "Large"
        },
        {
          "value": "h3",
          "label": "Medium"
        }
      ],
      "default": "h1"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Meet Sharon, the founder and cook behind The SoCal Vegan, creating flavorful, satisfying plant-based meals that make eating well feel easy.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop this week's menu"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "button_2_label",
      "label": "Second button label",
      "default": "Meet Sharon"
    },
    {
      "type": "url",
      "id": "button_2_link",
      "label": "Second button link"
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        {
          "value": "right",
          "label": "Right"
        },
        {
          "value": "left",
          "label": "Left"
        }
      ],
      "default": "right"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "info": "Leave empty to use the theme's accent color.",
      "default": "#cf2122"
    },
    {
      "type": "color",
      "id": "section_background_color",
      "label": "Section background",
      "default": "rgba(0,0,0,0)"
    },
    {
      "type": "header",
      "content": "Spacing & visibility"
    },
    {
      "type": "checkbox",
      "id": "descrease_margin",
      "label": "Decrease top margin",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "remove_margin",
      "label": "Remove top margin",
      "default": false
    },
    {
      "type": "select",
      "id": "section_visibility",
      "label": "Visibility",
      "options": [
        {
          "value": "always",
          "label": "Always"
        },
        {
          "value": "mobile",
          "label": "Mobile only"
        },
        {
          "value": "desktop",
          "label": "Desktop only"
        }
      ],
      "default": "always"
    }
  ],
  "presets": [
    {
      "name": "SoCal About hero"
    }
  ],
  "tag": "section"
}
{% endschema %}
