{%- comment -%}
  SoCal Partners — SoCal section for the Local theme (v4.2.1).
  Built on the theme's typography, color, border and spacing variables with one accent.
{%- endcomment -%}

{{ 'socal-sections.css' | asset_url | stylesheet_tag }}

<div class="{% render 'socal-section-wrapper', section: section %}">
  <div class="socal-section socal-partners" style="{% render 'socal-section-style', section: section %}">

    <div>
      {%- if section.settings.eyebrow != blank -%}
  <p class="socal-eyebrow text-size--small text-weight--bold">{{ section.settings.eyebrow | escape }}</p>
{%- endif -%}
      {%- if section.settings.heading != blank -%}
        <{{ section.settings.heading_tag }} class="{{ section.settings.heading_size }} socal-heading">{{ section.settings.heading | escape }}</{{ section.settings.heading_tag }}>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="socal-copy rte text-color--secondary">{{ section.settings.text }}</div>
      {%- endif -%}
      {%- if section.settings.button_label != blank or section.settings.button_2_label != blank -%}
  <div class="socal-buttons">
    {%- if section.settings.button_label != blank -%}
      <a class="button button--solid button--regular" href="{{ section.settings.button_link | default: '#' }}">{{ section.settings.button_label | escape }}</a>
    {%- endif -%}
    {%- if section.settings.button_2_label != blank -%}
      <a class="button button--outline button--regular" href="{{ section.settings.button_2_link | default: '#' }}">{{ section.settings.button_2_label | escape }}</a>
    {%- endif -%}
  </div>
{%- endif -%}
    </div>
    {%- if section.blocks.size > 0 -%}
      <ul class="socal-partners__list" role="list">
        {%- for block in section.blocks -%}
          <li class="socal-partners__item" {{ block.shopify_attributes }}>
            <span class="socal-partners__name">{% render 'socal-icon', icon: 'pin' %}<span class="text-weight--bold">{{ block.settings.name | escape }}</span></span>
            {%- if block.settings.city != blank -%}
              <span class="socal-partners__city text-size--small text-color--secondary">{{ block.settings.city | escape }}</span>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</div>

{%- render 'socal-section-background', section: section -%}

{% schema %}
{
  "name": "SoCal Partners",
  "class": "socal-partners-section",
  "max_blocks": 12,
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Rooted in North County"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Cooked in Carlsbad. Delivered up and down the coast."
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag (SEO)",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        }
      ],
      "default": "h2"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        {
          "value": "h1",
          "label": "Extra large"
        },
        {
          "value": "h2",
          "label": "Large"
        },
        {
          "value": "h3",
          "label": "Medium"
        }
      ],
      "default": "h2"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Every Monday before sunrise, meals head out to Oceanside, Vista, Carlsbad, Leucadia/Encinitas, Cardiff-by-the-Sea and Del Mar, plus four local partners who host our pickup spots.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "See the delivery area"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "button_2_label",
      "label": "Second button label"
    },
    {
      "type": "url",
      "id": "button_2_link",
      "label": "Second button link"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "info": "Leave empty to use the theme's accent color.",
      "default": "#cf2122"
    },
    {
      "type": "color",
      "id": "section_background_color",
      "label": "Section background",
      "default": "rgba(0,0,0,0)"
    },
    {
      "type": "header",
      "content": "Spacing & visibility"
    },
    {
      "type": "checkbox",
      "id": "descrease_margin",
      "label": "Decrease top margin",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "remove_margin",
      "label": "Remove top margin",
      "default": false
    },
    {
      "type": "select",
      "id": "section_visibility",
      "label": "Visibility",
      "options": [
        {
          "value": "always",
          "label": "Always"
        },
        {
          "value": "mobile",
          "label": "Mobile only"
        },
        {
          "value": "desktop",
          "label": "Desktop only"
        }
      ],
      "default": "always"
    }
  ],
  "blocks": [
    {
      "type": "partner",
      "name": "Partner",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Partner name"
        },
        {
          "type": "text",
          "id": "city",
          "label": "City",
          "default": "Vista"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "SoCal Partners",
      "blocks": [
        {
          "type": "partner",
          "settings": {
            "name": "CrossFit Trifecta",
            "city": "Vista"
          }
        },
        {
          "type": "partner",
          "settings": {
            "name": "FLXR CrossFit",
            "city": "Carlsbad"
          }
        },
        {
          "type": "partner",
          "settings": {
            "name": "North County Fitness & Performance",
            "city": "Vista"
          }
        },
        {
          "type": "partner",
          "settings": {
            "name": "Thousand Petal Lotus Vegan Market",
            "city": "Vista"
          }
        }
      ]
    }
  ],
  "tag": "section"
}
{% endschema %}
