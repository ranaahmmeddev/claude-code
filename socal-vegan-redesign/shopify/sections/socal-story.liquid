{%- comment -%}
  SoCal Story — SoCal section for the Local theme (v4.2.1).
  Built on the theme's typography, color, border and spacing variables with one accent.
{%- endcomment -%}

{{ 'socal-sections.css' | asset_url | stylesheet_tag }}

<div class="{% render 'socal-section-wrapper', section: section %}">
  <div class="socal-section socal-story" style="{% render 'socal-section-style', section: section %}">

    <div class="socal-story__side">
      {%- if section.settings.eyebrow != blank -%}
  <p class="socal-eyebrow text-size--small text-weight--bold">{{ section.settings.eyebrow | escape }}</p>
{%- endif -%}
      {%- if section.settings.heading != blank -%}
        <{{ section.settings.heading_tag }} class="{{ section.settings.heading_size }} socal-heading">{{ section.settings.heading | escape }}</{{ section.settings.heading_tag }}>
      {%- endif -%}
      {%- if section.settings.tagline != blank -%}
        <p class="socal-story__tagline text-size--large text-color--secondary">{{ section.settings.tagline | escape }}</p>
      {%- endif -%}
      {%- if section.settings.image != blank -%}
        <div class="socal-story__photo socal-media">
          {%- render 'lazy-image', image: section.settings.image, alt: section.settings.heading, ratio: '1', sizes: '(max-width: 1023px) calc(100vw - 40px), 22rem' -%}
        </div>
      {%- endif -%}
    </div>
    <div class="socal-story__body">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'lead' -%}
            <p class="socal-story__lead h4" {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</p>
          {%- when 'text' -%}
            <div class="rte text-size--large text-color--secondary" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
          {%- when 'quote' -%}
            <blockquote class="socal-story__quote h4" {{ block.shopify_attributes }}><p>{{ block.settings.text | escape }}</p></blockquote>
          {%- when 'signature' -%}
            <p class="socal-story__signature text-weight--bold" {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</p>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{%- render 'socal-section-background', section: section -%}

{% schema %}
{
  "name": "SoCal Story",
  "class": "socal-story-section",
  "max_blocks": 12,
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Founder & cook"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Hi, I'm Sharon."
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag (SEO)",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        }
      ],
      "default": "h2"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        {
          "value": "h1",
          "label": "Extra large"
        },
        {
          "value": "h2",
          "label": "Large"
        },
        {
          "value": "h3",
          "label": "Medium"
        }
      ],
      "default": "h1"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "Vegan eats specialist. Recipe whisperer. Spice fanatic."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Photo (optional)"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "info": "Leave empty to use the theme's accent color.",
      "default": "#cf2122"
    },
    {
      "type": "color",
      "id": "section_background_color",
      "label": "Section background",
      "default": "rgba(0,0,0,0)"
    },
    {
      "type": "header",
      "content": "Spacing & visibility"
    },
    {
      "type": "checkbox",
      "id": "descrease_margin",
      "label": "Decrease top margin",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "remove_margin",
      "label": "Remove top margin",
      "default": false
    },
    {
      "type": "select",
      "id": "section_visibility",
      "label": "Visibility",
      "options": [
        {
          "value": "always",
          "label": "Always"
        },
        {
          "value": "mobile",
          "label": "Mobile only"
        },
        {
          "value": "desktop",
          "label": "Desktop only"
        }
      ],
      "default": "always"
    }
  ],
  "blocks": [
    {
      "type": "lead",
      "name": "Intro line",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Your intro line"
        }
      ]
    },
    {
      "type": "text",
      "name": "Paragraph",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Your story.</p>"
        }
      ]
    },
    {
      "type": "quote",
      "name": "Quote",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Quote",
          "default": "A line worth highlighting."
        }
      ]
    },
    {
      "type": "signature",
      "name": "Signature",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "— Sharon King, Carlsbad, CA"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "SoCal Story",
      "blocks": [
        {
          "type": "lead",
          "settings": {
            "text": "I'm the face, cook, recipe tinkerer, and plant-powered foodie behind The SoCal Vegan."
          }
        },
        {
          "type": "text",
          "settings": {
            "text": "<p>What started from a love of good food, plants, flavor, and the Southern California lifestyle has grown into something I'm incredibly proud to share with my community in North County San Diego.</p>"
          }
        },
        {
          "type": "quote",
          "settings": {
            "text": "I believe eating plant-based shouldn't mean settling for boring salads or spending your entire Sunday meal-prepping."
          }
        },
        {
          "type": "text",
          "settings": {
            "text": "<p>It should be colorful, satisfying, flavorful, convenient, and something you actually look forward to eating.</p><p>That's why I create rotating weekly menus filled with thoughtfully prepared vegan meals designed to make your busy week a little easier.</p>"
          }
        },
        {
          "type": "signature",
          "settings": {
            "text": "— Sharon King, Carlsbad, CA"
          }
        }
      ]
    }
  ],
  "tag": "section"
}
{% endschema %}
